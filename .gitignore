# Leftovers from applying patches
*.orig
*.rej
*.bak*

# Python / OS
__pycache__/
.venv/
.DS_Store

# Local-only Claude Code settings (team-shared files such as .claude/settings.json are not ignored)
.claude/settings.local.json
.claude/*.local.md
.claude/*.local.json

# Local MCP servers and secrets (never in the public repo)
.mcp.json
# A plugin's own .mcp.json declares its bundled servers and must be committed
!plugins/*/.mcp.json
.env
.env.*

# Scratch space (agent research notes, worktrees for verification, etc.)
.tmp/
tmp/
*.log
