{
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/bash-guard.py\"" } ] },
      { "matcher": "mcp__.*__(issue_write|add_issue_comment|update_issue_comment|create_pull_request|update_pull_request|pull_request_review_write|add_comment_to_pending_review|add_reply_to_pull_request_comment)$", "hooks": [ { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/bash-guard.py\"" } ] },
      { "matcher": "Write", "hooks": [ { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/repo-structure-guard.py\"" } ] }
    ],
    "PostToolUse": [ { "matcher": "Bash|mcp__.*__merge_pull_request", "hooks": [ { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/git-freshness.py\"" } ] } ]
  }
}
