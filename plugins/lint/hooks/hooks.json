{
  "hooks": {
    "UserPromptExpansion": [
      { "matcher": "(^|:)skill-creator$", "hooks": [ { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/skill-creator-chain.py\" --expansion" } ] }
    ],
    "PostToolUse": [
      { "matcher": "^Skill$", "hooks": [ { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/skill-creator-chain.py\"" } ] }
    ]
  }
}
