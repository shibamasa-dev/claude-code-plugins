{
  "hooks": {
    "SessionStart": [ { "hooks": [ { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/dev_flow_gate.py\"" } ] } ],
    "PreToolUse": [
      { "matcher": "Bash|mcp__.*__(create_pull_request|merge_pull_request|enable_pr_auto_merge)", "hooks": [ { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/dev_flow_gate.py\"" } ] }
    ],
    "PostToolUse": [
      { "matcher": "Bash|Monitor|mcp__.*__(create_pull_request|merge_pull_request|enable_pr_auto_merge|issue_read|issue_write|subscribe_pr_activity)", "hooks": [ { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/dev_flow_gate.py\"" } ] }
    ],
    "Stop": [ { "hooks": [ { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/dev_flow_gate.py\"" } ] } ]
  }
}
