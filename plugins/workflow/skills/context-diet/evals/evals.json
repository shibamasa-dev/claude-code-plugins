[
  {
    "name": "healthy: within thresholds gives ok / exit 0 / no breach (including that the index exists)",
    "fixture": "healthy",
    "expect_verdict": "ok",
    "expect_exit": 0,
    "expect_no_breach": true,
    "expect_index_exists": true
  },
  {
    "name": "bloated_index: detects index average line length over threshold",
    "fixture": "bloated_index",
    "expect_verdict": "over_threshold",
    "expect_exit": 1,
    "expect_breach_contains": ["index_avg_line"]
  },
  {
    "name": "broken_links: missing index entries and missing bodies are breaches; unresolved [[link]] is info only",
    "fixture": "broken_links",
    "expect_verdict": "over_threshold",
    "expect_exit": 1,
    "expect_breach_contains": ["missing_from_index", "missing_bodies"],
    "expect_unresolved_wiki": 1
  },
  {
    "name": "oversize: detects always-loaded total over threshold",
    "fixture": "oversize",
    "expect_verdict": "over_threshold",
    "expect_exit": 1,
    "expect_breach_contains": ["standing_total"]
  },

  {
    "name": "inventory/fresh: lists personal and enabled-plugin skills, with plugin:skill names",
    "tool": "inventory",
    "fixture": "fresh",
    "expect_skill_names": ["keeper", "dropme", "demo:helper"],
    "expect_absent_skill_names": ["ghost:helper"],
    "expect_totals": {"skills_found": 3, "skills_already_overridden": 0},
    "expect_live_desc_bytes_gt": 0
  },
  {
    "name": "inventory/configured: reads denied/override from existing settings and excludes what is already done",
    "tool": "inventory",
    "fixture": "configured",
    "expect_skill_names": ["keeper", "dropme", "demo:helper"],
    "expect_totals": {"skills_found": 3, "skills_already_overridden": 2},
    "expect_denied": ["claude.ai Notion"],
    "expect_overridden": {"dropme": "user-invocable-only", "demo:helper": "off"}
  },
  {
    "name": "inventory/no-settings: returns empty without breaking when settings.json is missing",
    "tool": "inventory",
    "fixture": "no_settings",
    "expect_totals": {"skills_found": 3, "skills_already_overridden": 0},
    "expect_denied": [],
    "expect_settings_exists": false
  }
]
