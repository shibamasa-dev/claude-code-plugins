#!/usr/bin/env bash
set -euo pipefail

# --- Cross-platform keychain abstraction ---

store_secret() {
    local service="$1" account="$2" value="$3"
    case "$(uname)" in
        Darwin)
            security add-generic-password -s "$service" -a "$account" -w "$value" -U
            ;;
        Linux)
            echo "$value" | secret-tool store --label="$service" service "$service" account "$account"
            ;;
        *)
            echo "Error: Unsupported OS" >&2; exit 1
            ;;
    esac
}

get_secret() {
    local service="$1" account="$2"
    case "$(uname)" in
        Darwin)
            security find-generic-password -s "$service" -a "$account" -w 2>/dev/null || true
            ;;
        Linux)
            secret-tool lookup service "$service" account "$account" 2>/dev/null || true
            ;;
        *)
            echo "Error: Unsupported OS" >&2; exit 1
            ;;
    esac
}

SKILL_SERVICE={{ ("skill:" ~ skill_name) | sh_quote }}

usage() {
    echo "Usage: $0 <get|refresh> [scheme]"
    echo ""
    echo {{ ("Schemes: " ~ (schemes | map(attribute="name") | join(", "))) | sh_quote }}
    echo ""
    echo "Commands:"
    echo "  get      Get current access token (refreshes if not found)"
    echo "  refresh  Force token refresh"
    exit 1
}

[[ $# -lt 1 ]] && usage

COMMAND="$1"
SCHEME=${2:-{{ schemes[0].name | sh_quote }}}

resolve_token_url() {
    case "$SCHEME" in
{% for s in schemes %}
        {{ s.name | sh_quote }})
{% if s.openid_connect_url %}
            # discovery が返す token_endpoint も https のみ（http は localhost / 127.0.0.1 だけ）。認証情報を平文で送らない
            curl -sf {{ s.openid_connect_url | sh_quote }} | python3 -c 'import sys,json,re; u=json.load(sys.stdin).get("token_endpoint"); ok=isinstance(u,str) and re.fullmatch(sys.argv[1],u); print(u) if ok else sys.exit("Error: discovery の token_endpoint は使えません: %r" % (u,))' {{ auth_url_re | sh_quote }}
{% elif s.token_url %}
            echo {{ s.token_url | sh_quote }}
{% endif %}
            ;;
{% endfor %}
        *)
            echo "Error: Unknown scheme: $SCHEME" >&2; exit 1
            ;;
    esac
}

do_get() {
    local token
    token=$(get_secret "$SKILL_SERVICE" "${SCHEME}:access_token")
    if [[ -n "$token" ]]; then
        echo "$token"
    else
        do_refresh
    fi
}

do_refresh() {
    local client_id client_secret token_url response token

    client_id=$(get_secret "$SKILL_SERVICE" "${SCHEME}:client_id")
    client_secret=$(get_secret "$SKILL_SERVICE" "${SCHEME}:client_secret")

    if [[ -z "$client_id" || -z "$client_secret" ]]; then
        echo "Error: Credentials not found. Run setup.sh first." >&2
        exit 1
    fi

    token_url=$(resolve_token_url)

    response=$(curl -sf -X POST "$token_url" \
        -d "grant_type=client_credentials" \
        -d "client_id=${client_id}" \
        -d "client_secret=${client_secret}") || {
        echo "Error: Token request failed" >&2
        exit 1
    }

    token=$(echo "$response" | python3 -c "import sys,json; print(json.load(sys.stdin)['access_token'])")

    if [[ -z "$token" ]]; then
        echo "Error: No access_token in response" >&2
        exit 1
    fi

    store_secret "$SKILL_SERVICE" "${SCHEME}:access_token" "$token"
    echo "$token"
}

case "$COMMAND" in
    get) do_get ;;
    refresh) do_refresh ;;
    *) usage ;;
esac
