    {
      "id": "auth-pkce-creates-item-and-saves-tokens",
      "description": "With no token file, auth --client-id creates <plugin data>/spotify/token.json (mode 600, directory 700). The authorize URL uses PKCE (S256), a 127.0.0.1 redirect on the port from SPOTIFY_REDIRECT_PORT and only the needed scopes. A callback with the wrong state is refused; the right one is exchanged with code_verifier (no secret), and a later check uses the stored access token",
      "token_file_absent": true,
      "routes": {
        "POST /api/token": [
          {
            "status": 200,
            "json": {
              "access_token": "auth-access",
              "token_type": "Bearer",
              "expires_in": 3600,
              "refresh_token": "auth-refresh",
              "scope": "user-read-playback-state user-modify-playback-state user-read-currently-playing user-read-recently-played playlist-read-private playlist-read-collaborative playlist-modify-private playlist-modify-public user-library-read"
            }
          }
        ],
        "GET /v1/me": [
          {
            "status": 200,
            "json": {
              "id": "user_01",
              "display_name": "Test User"
            }
          }
        ]
      },
      "steps": [
        {
          "auth_callback": "wrong",
          "run": [
            "--client-id",
            "0123456789abcdef0123456789abcdef",
            "--port",
            "18765"
          ],
          "expect_code": 2,
          "expect_stderr_contains": [
            "state"
          ]
        },
        {
          "auth_callback": "ok",
          "run": [
            "--client-id",
            "0123456789abcdef0123456789abcdef"
          ],
          "expect_code": 0,
          "expect_stdout_not_contains": [
            "auth-access",
            "auth-refresh"
          ],
          "expect_authorize": {
            "client_id": "0123456789abcdef0123456789abcdef",
            "redirect_uri": "http://127.0.0.1:18765/callback",
            "code_challenge_method": "S256",
            "response_type": "code",
            "scope": "user-read-playback-state user-modify-playback-state user-read-currently-playing user-read-recently-played playlist-read-private playlist-read-collaborative playlist-modify-private playlist-modify-public user-library-read"
          },
          "expect_pkce": true
        },
        {
          "run": [
            "check"
          ],
          "expect_code": 0,
          "expect_json": {
            "ok": true,
            "user_id": "user_01"
          }
        }
      ],
      "expect_requests": [
        {
          "method": "POST",
          "path": "/api/token",
          "auth": null,
          "form": {
            "grant_type": "authorization_code",
            "code": "eval-code",
            "redirect_uri": "http://127.0.0.1:18765/callback",
            "client_id": "0123456789abcdef0123456789abcdef"
          }
        },
        {
          "method": "GET",
          "path": "/v1/me",
          "auth": "Bearer auth-access"
        }
      ],
      "expect_token_file": {
        "client_id": "0123456789abcdef0123456789abcdef",
        "refresh_token": "auth-refresh",
        "access_token": "auth-access"
      },
      "env": {
        "SPOTIFY_REDIRECT_PORT": "18765"
      },
      "expect_token_mode": {
        "file": "600",
        "dir": "700"
      }
    },
    {
