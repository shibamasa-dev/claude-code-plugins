    {
      "id": "refresh-writes-back-and-hides-token",
      "description": "Refreshes an expired access token with the PKCE refresh (client_id in the body, no Basic auth), writes back a new refresh token when one comes back and keeps the old one otherwise, keeps token.json at mode 600, and never prints a token",
      "token_file": {
        "client_id": "0123456789abcdef0123456789abcdef",
        "refresh_token": "old-refresh",
        "access_token": "expired-access",
        "expires_at": "1000"
      },
      "routes": {
        "POST /api/token": [
          {
            "status": 200,
            "json": {
              "access_token": "new-access-1",
              "token_type": "Bearer",
              "expires_in": 3600,
              "refresh_token": "new-refresh",
              "scope": "user-read-playback-state"
            }
          },
          {
            "status": 200,
            "json": {
              "access_token": "new-access-2",
              "token_type": "Bearer",
              "expires_in": 3600,
              "scope": "user-read-playback-state"
            }
          }
        ],
        "GET /v1/me": [
          {
            "status": 200,
            "json": {
              "id": "user_01",
              "display_name": "テストユーザー"
            }
          }
        ]
      },
      "steps": [
        {
          "run": [
            "check"
          ],
          "expect_code": 0,
          "expect_json": {
            "ok": true,
            "user_id": "user_01"
          },
          "expect_stdout_not_contains": [
            "new-access-1",
            "new-refresh"
          ]
        },
        {
          "expire_token_file": true
        },
        {
          "run": [
            "check"
          ],
          "expect_code": 0
        }
      ],
      "expect_requests": [
        {
          "method": "POST",
          "path": "/api/token",
          "auth": null,
          "form": {
            "grant_type": "refresh_token",
            "refresh_token": "old-refresh",
            "client_id": "0123456789abcdef0123456789abcdef"
          }
        },
        {
          "method": "GET",
          "path": "/v1/me",
          "auth": "Bearer new-access-1"
        },
        {
          "method": "POST",
          "path": "/api/token",
          "form": {
            "grant_type": "refresh_token",
            "refresh_token": "new-refresh"
          }
        },
        {
          "method": "GET",
          "path": "/v1/me",
          "auth": "Bearer new-access-2"
        }
      ],
      "expect_token_file": {
        "refresh_token": "new-refresh",
        "access_token": "new-access-2"
      },
      "expect_token_mode": {
        "file": "600",
        "dir": "700"
      }
    },
    {
      "id": "player-errors-and-empty",
      "description": "Nothing playing (204) gives playing: false; no active device (404 NO_ACTIVE_DEVICE) exits 1 with the reason; 429 waits for Retry-After and succeeds on retry; an unknown device name exits 2",
      "routes": {
        "GET /v1/me/player/currently-playing": [
          {
            "status": 204
          }
        ],
        "PUT /v1/me/player/play": [
          {
            "status": 404,
            "json": {
              "error": {
                "status": 404,
                "message": "Player command failed: No active device found",
                "reason": "NO_ACTIVE_DEVICE"
              }
            }
          }
        ],
        "GET /v1/me/player/recently-played": [
          {
            "status": 429,
            "headers": {
              "Retry-After": "0"
            },
            "json": {
              "error": {
                "status": 429,
                "message": "Too many requests",
                "reason": "QUOTA_EXCEEDED"
              }
            }
          },
          {
            "status": 200,
            "json": {
              "next": null,
              "cursors": {
                "after": "1",
                "before": "0"
              },
              "limit": 20,
              "items": [
                {
                  "played_at": "2026-11-28T09:30:00.000Z",
                  "context": {
                    "type": "playlist",
                    "uri": "spotify:playlist:1aB2cD3eF4gH5iJ6kL7mN8"
                  },
                  "track": {
                    "type": "track",
                    "name": "白日",
                    "uri": "spotify:track:2fF1kQJ0Ckx4aGkSuuHYuR",
                    "duration_ms": 277000,
                    "artists": [
                      {
                        "name": "King Gnu"
                      }
                    ],
                    "album": {
                      "name": "CEREMONY"
                    }
                  }
                }
              ]
            }
          }
        ],
        "GET /v1/me/player/devices": [
          {
            "status": 200,
            "json": {
              "devices": []
            }
          }
        ]
      },
      "steps": [
        {
          "run": [
            "now"
          ],
          "expect_code": 0,
          "expect_json": {
            "playing": false
          }
        },
        {
          "run": [
            "play",
            "--uris",
            "spotify:track:3dPQuX8Gs42Y7b454ybpMR"
          ],
          "expect_code": 1,
          "expect_stderr_contains": [
            "NO_ACTIVE_DEVICE"
          ]
        },
        {
          "run": [
            "recent"
          ],
          "expect_code": 0,
          "expect_json": [
            {
              "name": "白日",
              "artists": [
                "King Gnu"
              ],
              "played_at": "2026-11-28T09:30:00.000Z"
            }
          ]
        },
        {
          "run": [
            "play",
            "--device",
            "Echo",
            "--uris",
            "spotify:track:3dPQuX8Gs42Y7b454ybpMR"
          ],
          "expect_code": 2,
          "expect_stderr_contains": [
            "DEVICE_NOT_FOUND"
          ]
        }
      ]
    },
