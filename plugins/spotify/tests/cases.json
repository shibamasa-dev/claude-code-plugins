{
  "skill_name": "spotify",
  "note": "Cases for skills/spotify/scripts/spotify.py, run by spotify_cases.py against a local mock Spotify. No network beyond 127.0.0.1, no real 1Password: PATH holds only a recording op stub and the system directories. The response shapes come from the response examples in Spotify's Web API reference: devices=get-a-users-available-devices, play=start-a-users-playback (204), transfer=transfer-a-users-playback (one device_ids entry), currently-playing=get-the-users-currently-playing-track, recently-played=get-recently-played, /me/playlists=get-a-list-of-current-users-playlists (items.total), playlist items=get-playlists-items (items[].item, 2026-02), add=add-items-to-playlist (POST /items, 100 per request), /me/tracks=get-users-saved-tracks (items[].track, added_at), refresh=tutorials/refreshing-tokens (PKCE puts client_id in the body; a refresh_token may not come back). IDs and URIs are synthetic values in the right shape; the Japanese playlist and track names stand for Japanese user data. Behaviour the reference does not document (currently-playing 204, play 404 NO_ACTIVE_DEVICE, /me/tracks newest first) is mocked as commonly observed but is unverified against a real account.",
  "cases": [
    {
      "id": "play-and-transfer-by-device-name",
      "description": "Resolves the device_id from a partial device name and plays (PUT /me/player/play?device_id=..., body uris), then moves playback to another device (PUT /me/player, exactly one device_ids entry, play: true)",
      "routes": {
        "GET /v1/me/player/devices": [
          {
            "status": 200,
            "json": {
              "devices": [
                {
                  "id": "5fbb3ba6aa454b5534c4ba43a8c7e8e45a63ad0e",
                  "is_active": false,
                  "is_private_session": false,
                  "is_restricted": false,
                  "name": "Living Room MacBook",
                  "type": "Computer",
                  "volume_percent": 60,
                  "supports_volume": true
                },
                {
                  "id": "9e4c0d1f2a3b4c5d6e7f8091a2b3c4d5e6f70812",
                  "is_active": true,
                  "is_private_session": false,
                  "is_restricted": false,
                  "name": "iPhone",
                  "type": "Smartphone",
                  "volume_percent": 100,
                  "supports_volume": false
                }
              ]
            }
          }
        ],
        "PUT /v1/me/player/play": [
          {
            "status": 204
          }
        ],
        "PUT /v1/me/player": [
          {
            "status": 204
          }
        ]
      },
      "steps": [
        {
          "run": [
            "play",
            "--device",
            "macbook",
            "--uris",
            "spotify:track:3dPQuX8Gs42Y7b454ybpMR",
            "spotify:track:4KULAymBBJcPRpk1yO4dOG"
          ],
          "expect_code": 0,
          "expect_json": {
            "ok": true,
            "device_id": "5fbb3ba6aa454b5534c4ba43a8c7e8e45a63ad0e"
          }
        },
        {
          "run": [
            "transfer",
            "--device",
            "iPhone",
            "--play"
          ],
          "expect_code": 0,
          "expect_json": {
            "ok": true,
            "device": "iPhone"
          }
        }
      ],
      "expect_requests": [
        {
          "method": "PUT",
          "path": "/v1/me/player/play",
          "query": {
            "device_id": "5fbb3ba6aa454b5534c4ba43a8c7e8e45a63ad0e"
          },
          "body": {
            "uris": [
              "spotify:track:3dPQuX8Gs42Y7b454ybpMR",
              "spotify:track:4KULAymBBJcPRpk1yO4dOG"
            ]
          }
        },
        {
          "method": "PUT",
          "path": "/v1/me/player",
          "body": {
            "device_ids": [
              "9e4c0d1f2a3b4c5d6e7f8091a2b3c4d5e6f70812"
            ],
            "play": true
          }
        }
      ]
    },
