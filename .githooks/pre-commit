#!/bin/bash
# claude-code-plugins:pre-commit (marker install.sh uses to recognize its own hook; don't remove)
# Before committing to the public repo, stop personal-environment and internal-name leaks and non-noreply commit emails.
# Enable (once per clone, and again whenever this hook changes): bash .githooks/install.sh
# install.sh **copies** this hook and the check script into this repo's .git/hooks/. Pointing core.hooksPath
# straight at the working tree would mean that checking out an external PR branch and committing runs that
# PR's scripts locally (Codex security review finding).
# If you already used hooks from somewhere else (a global core.hooksPath, etc.), those also run after the checks.
# Internal names are read from a local file (newline-separated regexes), never from the repo:
#   ${XDG_CONFIG_HOME:-~/.config}/claude-code-plugins/blocked-patterns
set -u
hooks="$(cd "$(dirname "$0")" && pwd)"  # where install.sh put it (.git/hooks)

# Keep personal and company emails out of public commits (use the GitHub noreply address).
# Check the author and committer actually used, not git config (also catches --author and GIT_AUTHOR_EMAIL overrides)
for who in GIT_AUTHOR_IDENT GIT_COMMITTER_IDENT; do
  email=$(git var "$who" | sed -n 's/.*<\(.*\)>.*/\1/p')
  case "$email" in
    *@users.noreply.github.com) ;;
    *) echo "pre-commit: ${who%_IDENT} email is not a noreply address ($email). Set git config user.email <id>+<login>@users.noreply.github.com" >&2
       exit 1 ;;
  esac
done

f="${XDG_CONFIG_HOME:-$HOME/.config}/claude-code-plugins/blocked-patterns"
BLOCKED_PATTERNS="$( [ -r "$f" ] && cat "$f" )" python3 "$hooks/check-repo.py" --index >&2 || {
  echo "pre-commit: fix the problems above before committing" >&2
  exit 1
}

# Then run the earlier hooks, if any: a pre-commit that was in the same place (moved aside by install.sh)
# and the pre-commit in the earlier core.hooksPath (the location install.sh recorded)
if [ -x "$hooks/pre-commit.prior" ]; then
  "$hooks/pre-commit.prior" "$@" || exit $?
fi
prior=$(cat "$hooks/prior-hooks-path" 2>/dev/null || true)
if [ -n "$prior" ] && [ -x "$prior/pre-commit" ]; then
  exec "$prior/pre-commit" "$@"
fi
